# Copy this file to .env and fill in the values. Never commit .env.

# LINE Developers Console → your Messaging API channel → Basic settings
LINE_CHANNEL_SECRET=

# LINE Developers Console → Messaging API tab → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# Optional

# Postgres connection string. When set, data goes to Postgres instead of DATA_FILE.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# PORT=8080
# DATA_FILE=data/ledger.json
# TIMEZONE=Asia/Bangkok
